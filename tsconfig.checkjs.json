{
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "types": ["node"],
    "lib": ["es2022", "DOM", "DOM.Iterable"]
  },
  "include": ["lib/**/*.js", "types/**/*.d.ts"]
}
